# CareCircle AI Backend Environment Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# NVIDIA NIM API (Mistral Large)
NVIDIA_NIM_API_KEY=nvapi-your-key-here
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MISTRAL_MODEL=mistralai/mistral-large-4-1t-a52b

# MongoDB Database
MONGODB_URI=mongodb://localhost:27017/carecircle

# Qdrant Vector Store
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=carecircle_medical_memory

# Cloudinary Prescription Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Firebase Authentication
FIREBASE_PROJECT_ID=carecircle-ai
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@carecircle-ai.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Development & Testing Mode
# Set to 'true' to allow simulated authentication for offline development and initial unit testing
DEV_BYPASS_AUTH=true
DEV_MOCK_LLM=false
